/* ============================================
   Purpose:
   Initializes the DataWarehouse environment by
   creating the database and the bronze, silver,
   and gold schemas used in a Medallion Architecture.

   Warnings:
   - This script drops and recreates the DataWarehouse
     database. All existing data will be lost.
   - Requires admin privileges to run.
   - Locale settings may need adjustment depending
     on the operating system.
   - "\c DataWarehouse" works only in psql and should
     be removed when using GUI tools.
============================================ */


-- Drop the database if it already exists
DROP DATABASE IF EXISTS "DataWarehouse";

-- Create the database
CREATE DATABASE "DataWarehouse"
    WITH
        OWNER = postgres
        ENCODING = 'UTF8'
        LC_COLLATE = 'English_United States.1252'
        LC_CTYPE = 'English_United States.1252'
        LOCALE_PROVIDER = 'libc'
        TABLESPACE = pg_default
        CONNECTION LIMIT = -1
        IS_TEMPLATE = False;

-- Switch to the new database (psql only)
-- \c DataWarehouse;

-- Create Medallion Architecture Schemas
CREATE SCHEMA IF NOT EXISTS bronze;
CREATE SCHEMA IF NOT EXISTS silver;
CREATE SCHEMA IF NOT EXISTS gold;
